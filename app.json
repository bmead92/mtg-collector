{
  "expo": {
    "name": "MTG Collector",
    "slug": "mtg-price-scanner",
    "scheme": "mtgpricescanner",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.mtgpricescanner.app",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) uses the camera to photograph and identify your Magic cards."
      }
    },
    "android": {
      "package": "dev.mtgpricescanner.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1b1330",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 36,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "./plugins/withWindowsShortCxxPaths",
      "./plugins/withReleaseSigning",
      [
        "react-native-vision-camera-ocr-plus",
        {
          "disableTranslate": true,
          "disableNonLatinTextRecognition": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "# Nitro modules (VisionCamera, nitro-image, OCR) are reached from C++ by exact class/field name.\n-keep class com.margelo.nitro.** { *; }\n-keep class com.mrousavy.** { *; }\n"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
